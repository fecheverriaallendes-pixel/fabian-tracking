rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Transports collection
    match /transports/{transporteId} {
      allow read, write: if true;
    }

    // Shipments collection
    match /shipments/{despachoId} {
      allow read, write: if true;
    }
  }
}
